taExportTag":"Question 12","QuestionID":"QID52","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"}}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID53","SecondaryAttribute":"Is the city of Chicago in New York?","TertiaryAttribute":null,"Payload":{"QuestionText":"Is the city of Chicago in New York?","DefaultChoices":false,"DataExportTag":"Question 8","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Is the city of Chicago in New York?","Choices":{"1":{"Display":"5"},"2":{"Display":"8"},"3":{"Display":"D"},"4":{"Display":"d"},"5":{"Display":"Red"},"6":{"Display":"Computer"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None","MinChoices":"1","MaxChoices":"1"}},"GradingData":[],"AnalyzeChoices":{"1":"on"},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID53","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"}}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID55","SecondaryAttribute":"If you have any feedback, please feel free to share it here.\u00a0 Reminder: your response is fully an..","TertiaryAttribute":null,"Payload":{"QuestionText":"If you have any feedback, please feel free to share it here.&nbsp;<br>\n<br>\n<em>Reminder: your response is fully anonymous and will not be shared - please be honest!<\/em>","DefaultChoices":false,"DataExportTag":"Feedback Question","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If you have any feedback, please feel free to share it here.\u00a0 Reminder: your response is fully an...","Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID55"}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID56","SecondaryAttribute":"Would you like to enter into the raffle to win a prize? Your answers will still remain anonymous....","TertiaryAttribute":null,"Payload":{"QuestionText":"Would you like to enter into the raffle to win a prize? Your answers will still remain anonymous.&nbsp;<br>\n<br>\n<em>Note: Completion of the optional section of the survey will earn TWO (2) additional entries into the raffle, for a total of THREE (3) entries.<\/em>","DefaultChoices":false,"DataExportTag":"Raffle Question","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Would you like to enter into the raffle to win a prize? Your answers will still remain anonymous....","Choices":{"1":{"Display":"Yes, I would like to enter the raffle."},"2":{"Display":"No, I would NOT like to be entered into the raffle."}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID56"}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID57","SecondaryAttribute":"CODE_ID","TertiaryAttribute":null,"Payload":{"QuestionText":"CODE_ID","DefaultChoices":{"1":{"Selected":true}},"DataExportTag":"Q37","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"CODE_ID","Choices":{"1":{"Display":"${e:\/\/Field\/CODE_ID}"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID57","DisplayLogic":{"0":{"0":{"LogicType":"BooleanValue","Value":"False","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span><span> False<\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID58","SecondaryAttribute":"Consent to Participate in Research \u00a0 Title of Research Study: Measuring AI\u2019s Impact on the Job Se","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2><strong>Consent to Participate in Research<\/strong><\/h2>\n&nbsp;\n\n<br><b>Title of Research Study:<\/b> Measuring AI\u2019s Impact on the Job Search Process<p>\n<strong>Principal Investigator:<\/strong> Benjamin Golub<br>\n<strong>Student Investigator:<\/strong> Nicholas Qiu<br>\n<strong>Supported By:<\/strong> This research is supported by Northwestern University\u2019s Mathematical Methods in the Social Sciences department.<br>\n<strong>Key Information about this research study:<\/strong> The following is a short summary of this study to help you decide whether to be a part of this study. Information that is more detailed is explained later on in this form.<br>\n\u2022 The purpose of this study is to explore how students and early career professionals and graduates perceive certain social behaviors.<br>\n\u2022 You will be asked to complete a survey.<br>\n\u2022 We expect that you will be in this research study for 5-6 minutes, and an additional 1 minute for the optional section if you choose to complete it.<br>\n\u2022 There are attention checks in this survey. You can enter the raffle regardless of whether you pass these attention checks.<br>\n\u2022 The primary potential risk of participation is to the extent of preserving your privacy.<br>\n\u2022 The main benefit of being in this study is to help illuminate social perceptions about AI tools and people\u2019s usage of said tools.<br>\n<strong>Why am I being asked to take part in this research study?<\/strong><br>\nWe are asking you to take part in this research study because you are a university undergraduate, graduate student or early career professional who is at least 18 years of age. How many people will be in this study? We expect about 100 people will be in this research study. What should I know about participating in a research study?<br>\n\u2022 Whether or not you take part is up to you.<br>\n\u2022 You can choose not to take part.<br>\n\u2022 You can agree to take part and later change your mind.<br>\n\u2022 Your decision will not be held against you.<br>\n<strong>What happens if I say, \u201cYes, I want to be in this research\u201d?<\/strong><br>\nYou will be able to complete the required portion of the survey. This can be taken anywhere and at anytime after receiving the survey until April 30th. The survey duration will take approximately 5-6 minutes, and an additional optional portion will take another 1 minute. No audio or video recordings, and no photography will be taken as a part of this survey. Once you have completed the survey, then you can complete a separate form to enter into a raffle.<br>\n<strong>Will being in this study help me in any way?<\/strong><br>\nWe cannot promise any benefits to you or others from your taking part in this research. However, possible benefits include critical thinking and better knowledge for you. For the entire population of participants, they may gain general knowledge about AI tools and social behavior. This could allow for policymakers and companies to design policies and systems to control for and accommodate the rise in AI tools.<br>\n<strong>Is there any way being in this study could be bad for me?<\/strong><br>\nThere are risks regarding preserving your privacy. This risk will be very minimal, as the student researcher will take many precautions to preserve ones privacy. Questions will not ask you for any potentially incriminating information. Another risk of completing this survey is that you may not feel comfortable answering questions regarding AI usage in specific contexts. This risk is also minimal, as participants are able to not continue with the survey once they feel uncomfortable, and do not need to consider these hypothetical scenarios anymore. A possible risk for any research is that confidentiality could be compromised \u2013 that is, that people outside the study might get hold of confidential study information. We will do everything we can to minimize this risk, as described in more detail later in this form.<br>\n<strong>What happens if I do not want to be in this research, or I change my mind later?<\/strong><br>\nParticipation in research is voluntary. You can decide to participate or not to participate. If you do not want to be in this study or withdraw from the study at any point, your decision will not affect your relationship with any organization or group, including Northwestern University. For students, this will not affect any grades or class standing. You can leave the research at any time and it will not be held against you. If you decide to withdraw from this study before completing the survey, then any data already collected from you will be destroyed.<br>\n<strong>How will the researchers protect my information?<\/strong><br>\nTo keep participants\u2019 information secure, we are taking many precautions. For one, participants are able to take the survey from any location they feel comfortable to take the survey. In addition, once data is collected, they will be promptly cleaned of any information that could potentially identify them, including timestamps. In addition, survey data will be uploaded to a spreadsheet that is stored locally by the research team on a secured and encrypted device. Any identifiable research data, such as raffle entries, will be kept in a separate secured and encrypted device, and will also have timestamp data removed promptly after collection. Any physical copies of data will be stored in a folder that can only be accessed by the student researcher and principal investigator.<br>\n<strong>Who will have access to the information collected during this research study?<\/strong><br>\nEfforts will be made to limit the use and disclosure of your personal information, including research study records, to people who have a need to review this information. We cannot promise complete secrecy. There are reasons why information about you may be used or seen by other people beyond the research team during or after this study. Examples include:<br>\n\u2022 University officials, government officials, study funders, auditors, and the Institutional Review Board may need access to the study information to make sure the study is done in a safe and appropriate manner.<br>\nWe will not ask you about child abuse, but if you tell us about child abuse or neglect, we may be required or permitted by law or policy to report to authorities.<br>\nFor the purpose of future research, data will be stored on a public GitHub repository, where all potential identifying information will be scrubbed and cleaned. In addition, no data regarding raffle collection will be stored or uploaded to any public database or repository, and will be promptly deleted after raffle drawings are completed.<br>\n<strong>How might the information collected in this study be shared in the future?<\/strong><br>\nWe will keep the information we collect about you during this research study for study recordkeeping and for potential use in future research projects. De-identified data from this study may be shared with the research community, with journals in which study results are published, and with databases and data repositories used for research.<br>\n<strong>Will I be paid or given anything for taking part in this study?<\/strong><br>\nUpon completion of the required portion of the survey, you will be able to complete a separate form to enter your information for a raffle. Upon completion of the optional portion of the survey, you will be entitled to two entries for a total of three entries for the raffle. The raffle consists of 3 separate draws for a $50 Amazon gift card for each draw. Each entry ticket will have equal odds to win a raffle drawing. Once a participant has won a drawing, they are no longer eligible for an additional draw, and their additional tickets will be removed. The drawing will occur approximately two weeks after the closing of the survey, and will be contacted using their email address that they provide in the raffle entry form.<br>\n<strong>Who can I talk to?<\/strong><br>\nIf you have questions, concerns, or complaints, you can contact the Principal Investigator Benjamin Golub (<a href=\"mailto:ben.golub@gmail.com\">ben.golub@gmail.com<\/a>) and the student researcher Nicholas Qiu (<a href=\"mailto:nicholasqiu2026@u.northwestern.edu\">nicholasqiu2026@u.northwestern.edu<\/a>).<br>\nThis research has been reviewed and approved by an Institutional Review Board (\u201cIRB\u201d) \u2013 an IRB is a committee that protects the rights of people who participate in research studies. You may contact the IRB by phone at <a href=\"tel:(312) 503-1376\">(312) 503-1376<\/a> or by email at <a href=\"mailto:irbcompliance@northwestern.edu\">irbcompliance@northwestern.edu<\/a> if:<br>\n\u2022 Your questions, concerns, or complaints are not being answered by the research team.<br>\n\u2022 You cannot reach the research team. \u2022 You want to talk to someone besides the research team.<br>\n\u2022 You have questions about your rights as a research participant. \u2022 You want to get information or provide input about this research.<br>\n<strong>Optional Elements<\/strong>:<br>\nThere are two main portions of the survey. The first survey section is required, but there is a second section that is optional. You do not have to agree to complete this portion of the survey to participate in the research study. At the end of the optional portion of the survey, you may opt into completing the optional portion of the survey. That opt-in will count as your consent for taking the optional portion of the survey.<br>\n<br>\nIf you want a copy of this consent for your records, you can print it from the screen. If you cannot print the consent and would like a copy for your records, contact the Principal Investigator with the contact information above.<br>\n<br>\nIf you wish to participate, please check the \u201cI Agree\u201d box and select the right arrow button to be taken to the survey. If you do not wish to participate in this study, please select X in the corner of your browser.<\/p><br>","DefaultChoices":false,"DataExportTag":"Consent Page","QuestionID":"QID58","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Consent to Participate in Research \u00a0 Title of Research Study: Measuring AI\u2019s Impact on the Job Se...","Choices":{"4":{"Display":"I agree to participate in this research study."}},"ChoiceOrder":["4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID59","SecondaryAttribute":"What is your year?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your year?","DefaultChoices":false,"DataExportTag":"Q38","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your year?","Choices":{"1":{"Display":"Freshman"},"2":{"Display":"Sophomore"},"3":{"Display":"Junior"},"4":{"Display":"Senior"},"5":{"Display":"Graduate Student"},"6":{"Display":"New Grad (0-1 YOE)"},"7":{"Display":"Experienced Grad"},"9":{"Display":"Other"}},"ChoiceOrder":[1,2,3,4,5,6,7,"9"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":11,"NextAnswerId":1,"QuestionID":"QID59"}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"How acceptable or unacceptable do you consider each of the following actions during an interview?","TertiaryAttribute":null,"Payload":{"QuestionText":"How acceptable or unacceptable do you consider each of the following actions during an interview?","DefaultChoices":false,"DataExportTag":"Question 3","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"How acceptable or unacceptable do you consider each of the following actions during an interview?","Choices":{"1":{"Display":"Using AI tools during the interview"},"2":{"Display":"Using a search engine (e.g. Google) during the interview"},"3":{"Display":"Getting interview questions beforehand"},"4":{"Display":"Having someone else give live assist behind the scenes"},"5":{"Display":"Using handwritten notes for expected and common questions"},"6":{"Display":"Generating notes using AI tools"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":7,"Answers":{"1":{"Display":"Completely Unacceptable"},"2":{"Display":"Somewhat Unacceptable"},"3":{"Display":"Neutral"},"4":{"Display":"Somewhat Acceptable"},"5":{"Display":"Acceptable"},"6":{"Display":"Unsure"}},"AnswerOrder":[1,2,3,4,5,6],"ChoiceDataExportTags":false,"QuestionID":"QID6","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"}}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Please select the \"Yellow\" answer choice.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please select the \"Yellow\" answer choice.","DefaultChoices":false,"DataExportTag":"Question 4","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please select the \"Yellow\" answer choice.","Choices":{"1":{"Display":"Red"},"2":{"Display":"Blue"},"3":{"Display":"Yellow"},"4":{"Display":"Green"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID7\/SelectableChoice\/3","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Please select the \"Yellow\" answer choice.<\/span> <span class=\"LeftOpDesc\">Yellow<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID7\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID7","QuestionIDFromLocator":"QID7","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Validation Failed","libraryID":"UR_9TbDAQeLx66XgQS","messageID":"MS_Qv8JgFRymGsrRos","subMessageID":"VE_VALIDATION_FAILED"}}}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID7"}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Rank these 8 choices from MOST LIKELY (1) to LEAST LIKELY (8) reasons why a job-seeking student m...","TertiaryAttribute":null,"Payload":{"QuestionText":"Rank these 8 choices from MOST LIKELY (1) to LEAST LIKELY (8) reasons why a job-seeking student might choose to cheat in an interview.","DefaultChoices":false,"DataExportTag":"Question 5a","QuestionID":"QID8","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Rank these 8 choices from MOST LIKELY (1) to LEAST LIKELY (8) reasons why a job-seeking student m...","Choices":{"1":{"Display":"Desperation to find a job"},"2":{"Display":"High competition in the market"},"3":{"Display":"Lack of confidence"},"4":{"Display":"Unfair hiring process"},"5":{"Display":"Online interviews reduce risk of being caught"},"6":{"Display":"Cultural norms around academic or professional dishonesty"},"7":{"Display":"Lack of guidance on what is allowed vs. not allowed"},"8":{"Display":"Bandwagon because others are cheating"}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}