inue\" to continue with the optional portion of the survey. If you like to go to the end of the survey, then select \"No, skip to the end of the survey\".","DefaultChoices":false,"DataExportTag":"Branching Question","QuestionID":"QID29","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is the end of the required section. If you would like to provide some additional insight, th...","Choices":{"1":{"Display":"Yes, continue"},"2":{"Display":"No, skip to the end of the survey"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Introduction","TertiaryAttribute":null,"Payload":{"QuestionText":"Welcome!<br>\n<br>\nThank you for taking the time to complete this survey. This study explores how students and recent graduates perceive certain social behaviors regarding Artificial Intelligence. Your responses will be <b>completely anonymous<\/b> and only be used for academic research purposes. There are no right or wrong answers, so please answer honestly based on your own experiences and perceptions.<br>\n<br>\nThe required portion takes about <strong>6<\/strong><b><strong>&nbsp;<\/strong>minutes<\/b>, and completion will enter you into a raffle to win a 50$ Amazon gift card. An optional section will follow for participants who wish to provide additional insight, as well as an additional TWO entries into the raffle for those that complete the optional section.<br><br>\nClick the <em>right arrow<\/em>&nbsp;to begin.","DefaultChoices":false,"DataExportTag":"Intro","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Introduction","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID3"}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID31","SecondaryAttribute":"Overall, how fair do you believe the modern job interview process is for a qualified candidate?","TertiaryAttribute":null,"Payload":{"QuestionText":"Overall, how fair do you believe the modern job interview process is for a qualified candidate?","DefaultChoices":false,"DataExportTag":"Optional Question 1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Overall, how fair do you believe the modern job interview process is for a qualified candidate?","Choices":{"1":{"Display":"Extremely unfair"},"2":{"Display":"Somewhat unfair"},"3":{"Display":"Neither fair nor unfair"},"4":{"Display":"Somewhat fair"},"5":{"Display":"Extremely fair"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID31"}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID32","SecondaryAttribute":"How likely are you to report a friend or peer if you knew they cheated to get a job?","TertiaryAttribute":null,"Payload":{"QuestionText":"How likely are you to report a friend or peer if you knew they cheated to get a job?","DefaultChoices":false,"DataExportTag":"Optional Question 2","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"likelyUnlikely","Type":"likert","Reverse":false}}},"QuestionDescription":"How likely are you to report a friend or peer if you knew they cheated to get a job?","Choices":{"1":{"Display":"Extremely unlikely"},"2":{"Display":"Somewhat unlikely"},"3":{"Display":"Neither likely nor unlikely"},"4":{"Display":"Somewhat likely"},"5":{"Display":"Extremely likely"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID32"}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID33","SecondaryAttribute":"How confident are you that companies can effectively detect cheating in virtual interviews?","TertiaryAttribute":null,"Payload":{"QuestionText":"How confident are you that companies can effectively detect cheating in virtual interviews?","DefaultChoices":false,"DataExportTag":"Optional Question 3","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How confident are you that companies can effectively detect cheating in virtual interviews?","Choices":{"1":{"Display":"Not confident at all"},"2":{"Display":"Slightly confident"},"3":{"Display":"Moderately confident"},"4":{"Display":"Very confident"},"5":{"Display":"Extremely confident"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID33"}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID34","SecondaryAttribute":"How confident are you that companies act on suspected cheating?","TertiaryAttribute":null,"Payload":{"QuestionText":"How confident are you that companies act on suspected cheating?","DefaultChoices":false,"DataExportTag":"Optional Question 4","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How confident are you that companies act on suspected cheating?","Choices":{"1":{"Display":"Not confident at all"},"2":{"Display":"Slightly confident"},"3":{"Display":"Moderately confident"},"4":{"Display":"Very confident"},"5":{"Display":"Extremely confident"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID34"}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID36","SecondaryAttribute":"If a company discovers a candidate used AI to cheat on a critical hiring assessment, what do you...","TertiaryAttribute":null,"Payload":{"QuestionText":"If a company discovers a candidate used AI to cheat on a critical hiring assessment, what do you believe is the appropriate consequence?","DefaultChoices":false,"DataExportTag":"Optional Question 5","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If a company discovers a candidate used AI to cheat on a critical hiring assessment, what do you...","Choices":{"1":{"Display":"Warning, no penalty."},"2":{"Display":"Automatic disqualification from the current application."},"3":{"Display":"Permanent ban from applying to the company."},"4":{"Display":"No consequence, as it's part of modern technology use."},"5":{"Display":"Industry-wide ban"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID36"}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID37","SecondaryAttribute":"If a candidate secures a job primarily because of high-quality, AI-generated answers, how confide...","TertiaryAttribute":null,"Payload":{"QuestionText":"If a candidate secures a job primarily because of high-quality, AI-generated answers, how confident are you that they possess the genuine skills required for the role?","DefaultChoices":false,"DataExportTag":"Optional Question 6","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If a candidate secures a job primarily because of high-quality, AI-generated answers, how confide...","Choices":{"1":{"Display":"Not confident at all"},"2":{"Display":"Slightly confident"},"3":{"Display":"Moderately confident"},"4":{"Display":"Very confident"},"5":{"Display":"Extremely confident"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID37"}},{"SurveyID":"SV_2gI77ucHnkzYAwS","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"How common do you think the following activities are among students you know?","TertiaryAttribute":null,"Payload":{"QuestionText":"How common do you think the following activities are among students you know?","DefaultChoices":false,"DataExportTag":"Question 1","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"middle","MobileFirst":true,"ChoiceColumnWidthPixels":341,"WhiteSpace":"OFF"},"QuestionDescription":"How common do you think the following activities are among students you know?","Choices":{"1":{"Display":"Using their smartphone in the morning"},"2":{"Display":"Listening to music during daily activities (working, gym, cooking, etc.)"},"3":{"Display":"Drinking coffee, tea, or other caffeinated beverages at least once per week"},"4":{"Display":"Sky diving"},"5":{"Display":"Flying a helicopter"},"6":{"Display":"Paying someone else to take an interview for them"},"7":{"Display":"Going to the gym consistently"},"8":{"Display":"Cheating on a significant other"},"9":{"Display":"Us